<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HardwareLive.Core\HardwareLive.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>hardware-live</AssemblyName>
    <!-- Self-contained win-x64 publish (recipients have no .NET runtime) is done by
         tools/package.ps1 via `dotnet publish -p:SelfContained=true -r win-x64`, not baked in
         here, so a plain `dotnet build`/`dotnet test` stays framework-dependent and fast. -->
  </PropertyGroup>

</Project>
